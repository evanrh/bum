# Where the SQLite database lives inside the containers.
DATABASE_URL=/data/bum.db

# Port the web container publishes.
PORT=4321

# Optional: pin the first-run join code (otherwise one is generated and
# printed once in the `web` container logs).
BOOTSTRAP_JOIN_CODE=

# REQUIRED at build/dev time: the public origin the app is served from.
# Absolute OG links (og:url / og:image — Discord/Facebook unfurls) are
# baked into the build from it, so both `npm run build` and
# `docker compose build` fail without it. Docker: compose passes it as a
# build arg. Local example:
# SITE_URL=https://localhost:4321
SITE_URL=
