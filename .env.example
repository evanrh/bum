# Where the SQLite database lives inside the container — baked into the
# image (/data/bum.db). Compose does not forward this; override with
# `docker run -e DATABASE_URL=…` if you relocate the data.
DATABASE_URL=/data/bum.db

# Port inside the container (image default 4321). Compose does not forward
# this; it publishes the container's 4321 to host 4321.
PORT=4321

# Optional: pin the first-run join code (otherwise one is generated and
# printed once in the container logs).
BOOTSTRAP_JOIN_CODE=

# REQUIRED at runtime (issue #39 — no longer a build arg): the public
# origin the app is served from. OG links (og:url / og:image — Discord
# and Facebook unfurls) are minted from it per request. The container
# validates it at startup BEFORE anything else runs and exits with a
# clear error when it is missing or not an absolute http(s) URL.
# Local example:
# SITE_URL=https://localhost:4321
SITE_URL=
