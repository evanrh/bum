---
import '../styles/global.css';
import Avatar from '../components/Avatar.astro';
import NavDrawer from '../components/islands/NavDrawer.tsx';
import { getDb } from '../db/index.ts';
import * as avatarsRepo from '../db/repos/avatars.ts';
import { siteOrigin } from '../lib/config.ts';
import { submitEligibility, turnSummary } from '../lib/dashboard.ts';
import { FALLBACK_BLURB, joinUrl, ogImage } from '../lib/opengraph.ts';

interface Props {
  title?: string;
  og?: {
    description?: string;
    image?: string;
    imageAlt?: string;
    imageWidth?: number;
    imageHeight?: number;
  };
}

const { title = 'Bum', og = {} } = Astro.props;

// OG origins mint only from the runtime SITE_URL env — request origins are
// rewritten by the node adapter (issue #16), and nothing is baked at build
// time anymore (issue #39). Missing/invalid env throws loudly here, next
// to the boot entrypoint's preflight check.
const origin = siteOrigin();

const ogTitle = title;
const ogDescription = og.description ?? FALLBACK_BLURB;
const ogImageHref = ogImage({ coverUrl: og.image, origin });
// Dimensions/alt ride on the icon default only; covers arrive size-unknown.
const staticIcon = og.image === undefined || og.image === null || og.image === '';
const ogImageAlt = og.imageAlt ?? (staticIcon ? 'Bum logo' : undefined);
const ogImageWidth = og.imageWidth ?? (staticIcon ? 512 : undefined);
const ogImageHeight = og.imageHeight ?? (staticIcon ? 512 : undefined);
const ogUrl = joinUrl(origin, Astro.url.pathname);

const user = Astro.locals.user;
const db = getDb();
const summary = await turnSummary(db);
const youPick =
  user !== null && user.isActive && summary.pickerId === user.id && !summary.submitted;
const submitLink = user !== null && user.isActive ? await submitEligibility(db, user.id) : undefined;
const canSubmit = user !== null && user.isActive && submitLink.eligible;
// Presence/version check only — no image bytes ride along with every page.
const avatarMeta = user && user.isActive ? await avatarsRepo.getAvatarMeta(db, user.id) : undefined;
// Safe fields only for the client island — the session row carries the
// password hash and never crosses to the browser (issue #52).
const navUser =
  user === null ? null : { id: user.id, displayName: user.displayName, isAdmin: user.isAdmin };
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content="#18181b" />
    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bum" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageHref} />
    {
      ogImageWidth !== undefined && ogImageHeight !== undefined ? (
        <>
          <meta property="og:image:width" content={ogImageWidth.toString()} />
          <meta property="og:image:height" content={ogImageHeight.toString()} />
        </>
      ) : null
    }
    {ogImageAlt !== undefined ? <meta property="og:image:alt" content={ogImageAlt} /> : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImageHref} />
  </head>
  <body class="min-h-full bg-zinc-950 text-zinc-100 antialiased">
    <div class="mx-auto flex min-h-full max-w-3xl flex-col px-4 py-8">
      <header class="mb-6">
        <div class="flex items-center justify-between">
          <a href="/" class="text-lg font-semibold tracking-tight text-zinc-100">
            Bum
            <span class="ml-2 text-sm font-normal text-zinc-500">album review club</span>
          </a>
          {
            user ? (
              <div class="hidden items-center gap-3 text-sm md:flex">
                <a href="/profile" class="flex items-center gap-2" aria-label="your profile">
                  <Avatar userId={user.id} contentType={avatarMeta?.contentType ?? null} name={user.displayName} size="sm" />
                  <span class="text-zinc-400 hover:text-zinc-200">{user.displayName}</span>
                </a>
                <form method="post" action="/api/logout">
                  <button class="text-zinc-500 underline hover:text-zinc-300" type="submit">log out</button>
                </form>
              </div>
            ) : (
              <div class="hidden items-center gap-3 text-sm md:flex">
                <a href="/login" class="text-zinc-400 hover:text-zinc-200">log in</a>
                <a href="/signup" class="text-zinc-400 hover:text-zinc-200">sign up</a>
              </div>
            )
          }
          <div class="md:hidden">
            <NavDrawer
              client:load
              user={navUser}
              avatarContentType={avatarMeta?.contentType ?? null}
              canSubmit={canSubmit}
            />
          </div>
        </div>
        <nav class="mt-4 hidden gap-4 text-sm md:flex" aria-label="main">
          <a href="/" class="text-zinc-300 hover:text-white">dashboard</a>
          <a href="/albums" class="text-zinc-300 hover:text-white">albums</a>
          {user !== null ? (<a href="/profile" class="text-zinc-300 hover:text-white">profile</a>) : null}
          {user !== null ? (<a href="/backlog" class="text-zinc-300 hover:text-white">backlog</a>) : null}
          {
            canSubmit && (
              <a href="/submit" class="font-medium text-amber-400 hover:text-amber-300">
                submit your pick
              </a>
            )
          }
          {user?.isAdmin && <a href="/admin" class="text-zinc-300 hover:text-white">admin</a>}
        </nav>
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="mt-10 text-xs text-zinc-600">week of {summary.week}</footer>
    </div>
  </body>
</html>
