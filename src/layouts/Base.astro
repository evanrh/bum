---
import '../styles/global.css';
import { getDb } from '../db/index.ts';
import { submitEligibility, turnSummary } from '../lib/dashboard.ts';

interface Props {
  title?: string;
}

const { title = 'Bum' } = Astro.props;
const user = Astro.locals.user;
const db = getDb();
const summary = await turnSummary(db);
const youPick =
  user !== null && user.isActive && summary.pickerId === user.id && !summary.submitted;
const submitLink = user !== null && user.isActive ? await submitEligibility(db, user.id) : undefined;
const canSubmit = user !== null && user.isActive && submitLink.eligible;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-zinc-950 text-zinc-100 antialiased">
    <div class="mx-auto flex min-h-full max-w-3xl flex-col px-4 py-8">
      <header class="mb-6">
        <div class="flex items-center justify-between">
          <a href="/" class="text-lg font-semibold tracking-tight text-zinc-100">
            Bum
            <span class="ml-2 text-sm font-normal text-zinc-500">album review club</span>
          </a>
          {
            user ? (
              <div class="flex items-center gap-3 text-sm">
                <span class="text-zinc-400">{user.displayName}</span>
                <form method="post" action="/api/logout">
                  <button class="text-zinc-500 underline hover:text-zinc-300" type="submit">log out</button>
                </form>
              </div>
            ) : (
              <div class="flex items-center gap-3 text-sm">
                <a href="/login" class="text-zinc-400 hover:text-zinc-200">log in</a>
                <a href="/signup" class="text-zinc-400 hover:text-zinc-200">sign up</a>
              </div>
            )
          }
        </div>
        <nav class="mt-4 flex gap-4 text-sm" aria-label="main">
          <a href="/" class="text-zinc-300 hover:text-white">dashboard</a>
          <a href="/albums" class="text-zinc-300 hover:text-white">albums</a>
          {
            canSubmit && (
              <a href="/submit" class="font-medium text-amber-400 hover:text-amber-300">
                submit your pick
              </a>
            )
          }
          {user?.isAdmin && <a href="/admin" class="text-zinc-300 hover:text-white">admin</a>}
        </nav>
      </header>
      <main class="flex-1">
        <slot />
      </main>
      <footer class="mt-10 text-xs text-zinc-600">week of {summary.week}</footer>
    </div>
  </body>
</html>
