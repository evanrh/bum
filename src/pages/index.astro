---
import Base from '../layouts/Base.astro';
---

<Base title="Bum">
  <section class="rounded-xl border border-zinc-800 bg-zinc-900 p-8">
    <h1 class="text-2xl font-semibold tracking-tight">Welcome to Bum</h1>
    <p class="mt-2 text-zinc-400">
      A weekly album review club. Scaffolding only &mdash; the app is built feature by feature
      from the tickets in <code class="text-zinc-200">plans/</code>.
    </p>
    <ul class="mt-4 list-inside list-disc text-sm text-zinc-500">
      <li>T01: database foundation</li>
      <li>T02: rotation engine</li>
      <li>T03: auth &amp; sessions</li>
      <li>T04: albums &amp; ratings</li>
      <li>T05: jobs</li>
      <li>T06: pages &amp; islands</li>
      <li>T07: admin panel</li>
      <li>T08: docker</li>
      <li>T09: integration pass</li>
    </ul>
  </section>
</Base>
