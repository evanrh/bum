---
import { Show } from './react/Show.tsx';
import { spotifyEmbedUrl, youtubeEmbedUrl } from '../lib/external.ts';

interface Props {
  spotifyId?: string | null;
  youtubeId?: string | null;
  title: string;
}

const { spotifyId, youtubeId, title } = Astro.props;

const spotifySrc = spotifyId ? spotifyEmbedUrl(spotifyId) : undefined;
const youtubeSrc = youtubeId ? youtubeEmbedUrl(youtubeId) : undefined;
---

<Show when={spotifySrc}>
  <iframe
    src={spotifySrc!}
    class="w-full"
    height="152"
    loading="lazy"
    title={`${title} — Spotify`}
    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
  />
</Show>
{
  /* Lazy ternary (see Conventions): the old <Switch>/<Match> arms rendered
     here as eager slot strings that <Switch> dropped entirely — the YouTube
     embed and the placeholder never rendered. */
  youtubeSrc ? (
    <div class="aspect-video">
      <iframe
        src={youtubeSrc!}
        class="h-full w-full"
        loading="lazy"
        title={`${title} — YouTube`}
        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : !spotifySrc ? (
    <div class="rounded bg-zinc-900 px-6 py-8 text-center text-sm text-zinc-500">no preview available</div>
  ) : null
}
